# PKGBUILD for building AmpCraft from this repository checkout.
# From packaging/arch: `makepkg -si` (needs network for cargo fetch), or let
# scripts/build-arch-package.sh build it in a container and install the result with
# `sudo pacman -U dist/ampcraft-*.pkg.tar.zst`.

pkgname=ampcraft
pkgver=0.1.0
pkgrel=2
pkgdesc="Classic skinnable audio player (working name)"
arch=(x86_64)
url="https://github.com/Yuki-init/AmpCraft"
license=('MIT OR Apache-2.0')
depends=(ffmpeg alsa-lib gcc-libs glibc)
makedepends=(rustup clang pkgconf)
optdepends=(
  'kdialog: open-file and add-folder dialogs on KDE'
  'zenity: open-file and add-folder dialogs elsewhere'
  'noto-fonts-cjk: Japanese, Chinese and Korean titles'
  'pipewire-alsa: route ALSA output through PipeWire'
)
options=(!lto !debug)

# The repository this PKGBUILD lives in.
_root="$(cd "$startdir/../.." && pwd)"

prepare() {
  cd "$_root"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$_root"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked --offline -p ampcraft --bin ampcraft
}

package() {
  cd "$_root"
  install -Dm755 "$srcdir/target/release/ampcraft" "$pkgdir/usr/bin/ampcraft"
  install -Dm644 packaging/ampcraft.desktop "$pkgdir/usr/share/applications/ampcraft.desktop"
  install -Dm644 packaging/ampcraft.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ampcraft.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/ampcraft/README.md"
  install -Dm644 ATTRIBUTION.md "$pkgdir/usr/share/doc/ampcraft/ATTRIBUTION.md"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/ampcraft/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/ampcraft/LICENSE-APACHE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/ampcraft/NOTICE"
}
